// Everheart Prisma schema – Supabase Postgres (pooler for runtime, direct for migrations)
// Run: pnpm prisma generate && pnpm prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String         @id @default(cuid())
  clerkId           String?        @unique // or external auth id
  email             String?        @unique
  displayName       String?
  isAdultVerified   Boolean        @default(false)
  adultVerifiedAt   DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  entitlements      Entitlement[]
  companions        Companion[]
  messages          Message[]
  ledgerEntries     LedgerEntry[]
  memoryFacts       MemoryFact[]
  memoryEntities    MemoryEntity[]
  memoryEpisodes    MemoryEpisode[]
  summaries         Summary[]
  openRouterKeyEnc  String?        // encrypted BYOK LLM key (DeepSeek; never store plain)

  @@map("eh_user")
}

model Entitlement {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier          String   // "starter" | "standard" | "creator"
  source        String   // "stripe" | "gumroad" | "appsumo" | "manual"
  stripeSession String?
  activatedAt   DateTime @default(now())
  expiresAt     DateTime? // null = lifetime
  features      Json     // feature flags snapshot

  @@index([userId])

  @@map("eh_entitlement")
}

model Companion {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  cardJson      Json     // full SillyTavern-compatible card
  portraitUrl   String?
  isNsfw        Boolean  @default(false)
  isPublic      Boolean  @default(false) // for future marketplace
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages      Message[]
  memories      MemoryFact[]
  memoryEntities MemoryEntity[]
  memoryEpisodes MemoryEpisode[]
  summaries     Summary[]

  @@index([userId])

  @@map("eh_companion")
}

model Message {
  id            String   @id @default(cuid())
  companionId   String
  companion     Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String   // "user" | "assistant" | "system"
  content       String
  tokenCount    Int?
  createdAt     DateTime @default(now())

  @@index([companionId, createdAt])
  // Per-user history reads (chat page reload, Phase P1).
  @@index([userId, companionId, createdAt])

  @@map("eh_message")
}

/// One durable fact the companion remembers about this user.
model MemoryFact {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companionId   String
  companion     Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  fact          String
  importance    Float                       @default(0.5)
  /// "fact" | "boundary" — boundaries are always injected into the prompt.
  category      String                      @default("fact")
  createdAt     DateTime                    @default(now())
  /// Mirrors `MemoryItem.lastUsedAt` on the client (used by recency ranking).
  lastAccessed  DateTime                    @default(now())

  @@index([userId, companionId])

  @@map("eh_memory_fact")
}

/// A named person/thing the companion knows about ("Rex: user's dog").
model MemoryEntity {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companionId  String
  companion    Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  name         String
  note         String   @default("")
  importance   Float    @default(0.5)
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId, companionId])

  @@map("eh_memory_entity")
}

/// A compacted past conversation segment (episodic memory).
model MemoryEpisode {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companionId  String
  companion    Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  summary      String
  /// Space-separated keywords (client sends string[]).
  keywords     String   @default("")
  importance   Float    @default(0.5)
  startAt      DateTime @default(now())
  endAt        DateTime @default(now())

  @@index([userId, companionId])

  @@map("eh_memory_episode")
}

/// Rolling summary + counters. One row per (user, companion): it doubles as the
/// header record for that companion's memory (counters exist before the first
/// summary is produced, hence the defaults).
model Summary {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companionId   String
  companion     Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  content       String   @default("")
  /// Exchanges seen so far (CompanionMemory.messageCount).
  messageCount  Int      @default(0)
  /// messageCount at the last summary fold (CompanionMemory.lastSummaryAt).
  lastSummaryAt Int      @default(0)
  /// CompanionMemory schema version (client owns the shape).
  version       Int      @default(2)
  updatedAt     DateTime @updatedAt

  @@unique([userId, companionId])

  @@map("eh_summary")
}

model LedgerEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // "credit_purchase" | "usage" | "license_bonus" | "refund"
  amountTokens  Int      // positive = credit, negative = debit
  description   String?
  referenceId   String?  // stripe payment intent, etc.
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])

  @@map("eh_ledger_entry")
}

model CharacterCardTemplate {
  id          String   @id @default(cuid())
  name        String
  archetype   String?
  cardJson    Json
  isNsfw      Boolean  @default(false)
  isSeeded    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("eh_character_card_template")
}
