# Database (Supabase Postgres; Prisma CLI reads `.env`, Next.js also reads `.env.local`)
# Runtime uses the transaction-mode pooler (6543); migrations use DIRECT_URL (5432).
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-us-west-1.pooler.supabase.com:5432/postgres"

# Supabase REST (for future server-side supabase-js usage)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Auth (Clerk example – or use NextAuth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# LLM (DeepSeek)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Optional: Image gen
FAL_KEY=
REPLICATE_API_TOKEN=

# Age verification (later)
VERIFF_API_KEY=
STRIPE_IDENTITY_...
